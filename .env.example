# Copy to .env and fill in your own local Postgres credentials.
# Special characters in the password must be percent-encoded (@ -> %40, ! -> %21).
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/bank

# Required. The app refuses to start if this is unset or left as "replace me".
# Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
